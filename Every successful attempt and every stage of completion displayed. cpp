#include <iostream>
#include <cstdlib>
#include <thread>   
#include <chrono>  

#ifdef _WIN32
#include <windows.h>
#else
#include <locale.h>
#endif

using namespace std;

void initTerminal() {
    #ifdef _WIN32
    system("chcp 65001 > nul");
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    DWORD dwMode = 0;
    GetConsoleMode(hOut, &dwMode);
    dwMode |= ENABLE_VIRTUAL_TERMINAL_PROCESSING;
    SetConsoleMode(hOut, &dwMode);
    #else
    setlocale(LC_ALL, "en_US.UTF-8");
    #endif
}

